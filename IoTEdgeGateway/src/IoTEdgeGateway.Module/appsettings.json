{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "IoTEdgeGateway": "Debug"
    }
  },
  "Gateway": {
    "Mqtt": {
      "Enabled": true,
      "BrokerHost": "localhost",
      "BrokerPort": 1883,
      "ClientId": "iot-edge-gateway",
      "UseTls": false,
      "TopicsToSubscribe": [ "devices/+/telemetry", "sensors/+/data" ],
      "KeepAliveSeconds": 30,
      "ReconnectDelaySeconds": 5,
      "MaxReconnectAttempts": 10
    },
    "OpcUa": {
      "Enabled": true,
      "ServerUrl": "opc.tcp://localhost:4840",
      "AcceptUntrustedCertificates": false,
      "SessionTimeoutMs": 30000,
      "PublishingIntervalMs": 1000,
      "NodesToMonitor": [
        {
          "NodeId": "ns=2;s=Device1.Temperature",
          "DisplayName": "temperature",
          "SamplingIntervalMs": 500,
          "MinThreshold": -10.0,
          "MaxThreshold": 120.0,
          "Unit": "°C"
        },
        {
          "NodeId": "ns=2;s=Device1.Pressure",
          "DisplayName": "pressure",
          "SamplingIntervalMs": 500,
          "MinThreshold": 0.0,
          "MaxThreshold": 200.0,
          "Unit": "bar"
        }
      ]
    },
    "Modbus": {
      "Enabled": true,
      "Host": "localhost",
      "Port": 502,
      "SlaveId": 1,
      "PollingIntervalMs": 1000,
      "TimeoutMs": 3000,
      "MaxRetries": 3,
      "Registers": [
        {
          "Address": 40001,
          "Name": "motor_speed",
          "Type": "holding",
          "DataType": "uint16",
          "Scale": 0.1,
          "Offset": 0.0,
          "Unit": "RPM",
          "MinThreshold": 0.0,
          "MaxThreshold": 3000.0
        },
        {
          "Address": 40002,
          "Name": "motor_current",
          "Type": "holding",
          "DataType": "uint16",
          "Scale": 0.01,
          "Offset": 0.0,
          "Unit": "A",
          "MinThreshold": 0.0,
          "MaxThreshold": 100.0
        }
      ]
    },
    "IoTHub": {
      "ConnectionString": "",
      "TelemetrySendIntervalMs": 5000,
      "MaxBatchSize": 100,
      "RetryMaxAttempts": 5,
      "RetryBaseDelayMs": 1000,
      "ModelId": ""
    },
    "Alert": {
      "MaxActiveAlerts": 1000,
      "LogAlertsLocally": true,
      "SendAlertsToCloud": true,
      "AlertCooldownSeconds": 60
    },
    "Filter": {
      "ExcludeInvalidDataPoints": true,
      "EnableDeduplication": true,
      "DeduplicationWindowSeconds": 5,
      "MaxDataPointsPerMessage": 200
    },
    "Validation": {
      "MaxTemperatureCelsius": 150.0,
      "MinTemperatureCelsius": -40.0,
      "MaxPressureBar": 250.0,
      "MaxHumidityPercent": 100.0,
      "MaxVibrationG": 50.0,
      "MaxCurrentAmps": 1000.0,
      "MaxVoltageVolts": 15000.0,
      "MaxDataAgeMinutes": 5
    }
  }
}
